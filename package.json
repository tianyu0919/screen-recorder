{
  "name": "screen-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Screen Studio-like screen recorder: record data, apply auto camera motion at export time",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "postinstall": "node scripts/patch-electron-name.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:native": "node native/build.mjs",
    "dist": "npm run build:native && npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "mediabunny": "^1.55.1",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "uiohook-napi": "^1.5.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^39.1.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
